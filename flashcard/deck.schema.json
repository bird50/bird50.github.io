{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:recall:deck:v1",
  "title": "Recall Deck v1",
  "type": "object",
  "required": ["format", "version", "id", "title", "cards"],
  "properties": {
    "format": {"const": "recall.deck"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "\\S"},
    "title": {"type": "string", "pattern": "\\S"},
    "description": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "cards": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/card"}}
  },
  "$defs": {
    "card": {
      "type": "object", "required": ["id", "front", "back"],
      "properties": {
        "id": {"type": "string", "pattern": "\\S"},
        "front": {"$ref": "#/$defs/side"},
        "back": {"$ref": "#/$defs/side"}
      }
    },
    "side": {
      "type": "object", "required": ["text"],
      "properties": {
        "text": {"type": "string"},
        "image": {"type": "object", "required": ["src", "alt"], "properties": {
          "src": {"type": "string", "pattern": "^(https://[^\\s]+|data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/=]+)$"},
          "alt": {"type": "string"}
        }}
      },
      "anyOf": [{"properties": {"text": {"pattern": "\\S"}}}, {"required": ["image"]}]
    }
  }
}
